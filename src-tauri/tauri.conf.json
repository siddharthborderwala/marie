{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Marie",
  "version": "0.1.0",
  "identifier": "app.marie.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marie",
        "width": 1320,
        "height": 860,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "\u00a9 2026 Siddharth Borderwala",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRTkzMzYyNTlBOUJBOEMKUldTTXVxbFpZalBwWE1LUlB1WDliMjhONUNaNkNZaGNtS0QyeHVONnRheFdkdVhibGhvTGxpeEoK",
      "endpoints": [
        "https://github.com/siddharthborderwala/marie/releases/latest/download/latest.json"
      ]
    }
  }
}
